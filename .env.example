# The judge uses the same free Gemini tier as the agent under test.
BACKEND=gemini
GOOGLE_API_KEY=your-key-here

# Judge model. Its own setting, so the judge is never silently swapped along with
# the agent's model (MODEL below).
# JUDGE_MODEL=gemini-flash-lite-latest

# The agent's model, read by the agent's own code.
# MODEL=gemini-flash-lite-latest

# Requests per minute the harness allows itself. The free flash-lite tier allows
# 15; 10 leaves headroom so 429 backoff does not distort the latency numbers.
# LLM_RPM=10
# LLM_RETRIES=5

# Path to the agent being tested (default: ../riyadh-sql-agent)
# SQL_AGENT_PATH=../riyadh-sql-agent
